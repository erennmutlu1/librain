# Copy to .env.local and adjust. Every variable is optional.

# Serve every API call from recorded fixtures (no network). Defaults to "true"
# under `npm run dev` and "false" in production builds.
VITE_USE_MOCKS=true

# Where the Vite dev-server proxy forwards /api and /health in real mode.
VITE_API_PROXY_TARGET=http://localhost:5000

# Absolute API origin for production builds that are not served behind the
# same origin as the API (the API must then allow this site via CORS).
# Leave empty to call relative paths (/api/...).
VITE_API_BASE_URL=

# Public build for the static site (GitHub Pages). "true" shows recorded runs by
# default and offers a Live mode in which visitors paste their own Anthropic and
# OpenAI keys; those are sent only to VITE_API_BASE_URL. Uploads, deletes and
# the server run history are hidden. VITE_USE_MOCKS is ignored when this is on.
# Leave unset for every other build.
VITE_PUBLIC_DEMO=
